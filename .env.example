# Copy to .env in repository root. Never commit real values.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/solcacao
# The API refuses to start without a reachable MongoDB and a random JWT secret of 32+ characters.
# npm run setup generates one; otherwise: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters-before-phase2
VITE_API_MODE=mock
VITE_API_BASE_URL=/api
# Dev-only B2B demo knob (mock mode only): success | fail-first | notification-failed
# VITE_B2B_MOCK_SCENARIO=success
UPLOAD_DIR=server/storage
# Production only: the built client (dist/client). The API then serves the site and refreshes deep
# links. Leave unset in development, where Vite serves the client.
# CLIENT_DIST_DIR=dist/client
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=solcacao@example.test
SUPPORT_EMAIL=support@example.test
# Optional public business number, digits only; blank disables WhatsApp link.
VITE_WHATSAPP_NUMBER=
