{
  "name": "solcacao-template",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run check:structure && npm run check:workflow",
    "check:structure": "node scripts/check-structure.mjs",
    "phase": "node scripts/phase-brief.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "agent": "node scripts/phase-brief.mjs --packet",
    "setup": "node scripts/setup.mjs",
    "services": "node scripts/services.mjs",
    "seed:catalog": "tsx server/src/features/catalog/seed.ts",
    "check:workflow": "node scripts/check-workflow.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "bcrypt": "6.0.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.45.0",
    "mongoose": "9.11.4",
    "multer": "2.5.0",
    "nodemailer": "10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "6.30.6",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@11.9.0"
}
